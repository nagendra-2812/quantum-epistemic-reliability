from __future__ import annotations

import importlib.util
import json
import sys
import traceback
from datetime import datetime, timezone
from pathlib import Path


PROJECT = Path(
    r"D:\AI\quantum-epistemic-reliability"
)

TRAINING_SCRIPT = (
    PROJECT
    / "scripts"
    / "ASUS_21_TRAINING.py"
)

EXPERIMENT_ROOT = (
    PROJECT
    / "experiments"
    / "BreaKHis"
)

SEEDS = [42, 123, 2025]
FOLDS = [1, 2, 3, 4, 5]


def utc_now():
    return datetime.now(
        timezone.utc
    ).isoformat()


def load_training_module():
    spec = importlib.util.spec_from_file_location(
        "asus21_training_runtime",
        TRAINING_SCRIPT,
    )

    if spec is None or spec.loader is None:
        raise RuntimeError(
            f"Cannot load training script: {TRAINING_SCRIPT}"
        )

    module = importlib.util.module_from_spec(
        spec
    )

    sys.modules[
        "asus21_training_runtime"
    ] = module

    spec.loader.exec_module(
        module
    )

    return module


def cell_directory(
    fold,
    seed,
):
    return (
        EXPERIMENT_ROOT
        / f"fold_{fold:02d}"
        / f"seed_{seed}"
    )


def completion_file(
    fold,
    seed,
):
    return (
        cell_directory(
            fold,
            seed,
        )
        / "CELL_COMPLETE.json"
    )


def is_complete(
    fold,
    seed,
):

    marker = completion_file(
        fold,
        seed,
    )

    if not marker.exists():
        return False

    try:
        payload = json.loads(
            marker.read_text(
                encoding="utf-8"
            )
        )

        return (
            payload.get("status")
            == "COMPLETE"
            and
            payload.get("fold")
            == fold
            and
            payload.get("seed")
            == seed
        )

    except Exception:
        return False


def write_cell_marker(
    fold,
    seed,
    status,
    error=None,
):

    directory = cell_directory(
        fold,
        seed,
    )

    directory.mkdir(
        parents=True,
        exist_ok=True,
    )

    payload = {
        "status": status,
        "fold": fold,
        "seed": seed,
        "created_utc": utc_now(),
    }

    if error is not None:
        payload["error"] = error

    completion_file(
        fold,
        seed,
    ).write_text(
        json.dumps(
            payload,
            indent=2,
        ),
        encoding="utf-8",
    )


def run_cell(
    fold,
    seed,
):

    directory = cell_directory(
        fold,
        seed,
    )

    print()
    print("=" * 100)
    print(
        f"ASUS-21 FULL EXPERIMENT"
    )
    print(
        f"FOLD {fold:02d}/05 | SEED {seed}"
    )
    print("=" * 100)

    module = load_training_module()

    # Override the pilot globals WITHOUT modifying the
    # verified training source file.
    module.PILOT_FOLD = fold
    module.PILOT_SEED = seed

    # Each fold/seed gets its own immutable output directory.
    module.OUTPUT_ROOT = directory

    module.AUDIT_FILE = (
        directory
        / "ASUS-21_CELL_AUDIT.json"
    )

    # Main() will execute the exact seven-arm implementation.
    module.main()

    # The training script writes PILOT_RESULTS.json even though
    # this execution is a full-experiment cell.
    results_file = (
        directory
        / "PILOT_RESULTS.json"
    )

    if not results_file.exists():
        raise RuntimeError(
            "Cell finished without producing "
            f"{results_file}"
        )

    payload = json.loads(
        results_file.read_text(
            encoding="utf-8"
        )
    )

    executed = payload.get(
        "executed_arms",
        []
    )

    blocked = payload.get(
        "blocked_arms",
        []
    )

    expected_arms = [
        "softmax",
        "temperature_scaled",
        "mc_dropout",
        "deep_ensemble",
        "deterministic_vqc",
        "laplace_vqc",
        "laplace_mlp",
    ]

    if executed != expected_arms:
        raise RuntimeError(
            "Unexpected executed-arm list:\n"
            f"{executed}"
        )

    if blocked != []:
        raise RuntimeError(
            "Cell contains blocked arms:\n"
            f"{blocked}"
        )

    write_cell_marker(
        fold,
        seed,
        "COMPLETE",
    )

    print()
    print(
        f"COMPLETED: Fold {fold:02d} / Seed {seed}"
    )


def main():

    if not TRAINING_SCRIPT.exists():
        raise FileNotFoundError(
            TRAINING_SCRIPT
        )

    EXPERIMENT_ROOT.mkdir(
        parents=True,
        exist_ok=True,
    )

    total = (
        len(FOLDS)
        * len(SEEDS)
    )

    completed = 0
    failed = 0
    skipped = 0

    print("=" * 100)
    print(
        "ASUS-21 Ã¢â‚¬â€ FULL 5-FOLD Ãƒâ€” 3-SEED RUNNER"
    )
    print("=" * 100)
    print(
        f"Cells: {total}"
    )
    print(
        "Folds:",
        FOLDS,
    )
    print(
        "Seeds:",
        SEEDS,
    )
    print(
        "Experimental arms: 7"
    )
    print(
        "Total arm-level executions:",
        total * 7,
    )
    print("=" * 100)

    for fold in FOLDS:

        for seed in SEEDS:

            if is_complete(
                fold,
                seed,
            ):

                skipped += 1

                print()
                print(
                    f"SKIP COMPLETE: "
                    f"Fold {fold:02d} / Seed {seed}"
                )

                continue

            try:

                run_cell(
                    fold,
                    seed,
                )

                completed += 1

            except KeyboardInterrupt:

                print()
                print(
                    "RUNNER INTERRUPTED."
                )
                print(
                    "Completed cells:",
                    completed,
                )
                print(
                    "Skipped cells:",
                    skipped,
                )
                print(
                    "Failed cells:",
                    failed,
                )
                print(
                    "Resume by running the same command again."
                )

                return 2

            except Exception as exc:

                failed += 1

                error_text = (
                    traceback.format_exc()
                )

                print()
                print(
                    f"FAILED: Fold {fold:02d} / Seed {seed}"
                )
                print(
                    error_text
                )

                write_cell_marker(
                    fold,
                    seed,
                    "FAILED",
                    error=error_text,
                )

                print(
                    "Stopping immediately after failure."
                )
                print(
                    "No later cells will be started."
                )
                print(
                    "Fix the failed cell, then rerun "
                    "the same runner."
                )

                return 1

    print()
    print("=" * 100)
    print(
        "ASUS-21 FULL EXPERIMENT RUNNER COMPLETE"
    )
    print("=" * 100)
    print(
        "Completed cells:",
        completed,
    )
    print(
        "Skipped existing cells:",
        skipped,
    )
    print(
        "Failed cells:",
        failed,
    )

    if (
        completed + skipped == total
        and failed == 0
    ):

        print()
        print(
            "FULL 105-ARM EXPERIMENT COMPLETE"
        )
        print(
            f"Results root: {EXPERIMENT_ROOT}"
        )

        return 0

    return 1


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
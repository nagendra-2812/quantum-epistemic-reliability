# ============================================================
# FROZEN PILOT CONFIGURATION
# ============================================================

SEED = 2026

IMAGE_SIZE = 224
LATENT_DIM = 32

N_QUBITS = 6
VQC_DEPTH = 2

BATCH_SIZE = 16

EPOCHS_MLP = 10
EPOCHS_VQC = 10

LR_MLP = 1e-3
LR_VQC = 1e-2

WEIGHT_DECAY = 1e-4

NUM_WORKERS = 0

DEVICE = torch.device(
    "cuda:0"
    if torch.cuda.is_available()
    else "cpu"
)


# ============================================================
# REPRODUCIBILITY
# ============================================================

def seed_everything(seed: int) -> None:

    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)

    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)

    torch.backends.cudnn.deterministic = True
    torch.backends.cudnn.benchmark = False


# ============================================================
# DICOM
# ============================================================

def load_dicom(
    path: str,
) -> np.ndarray:

    ds = pydicom.dcmread(
        path,
        force=True,
    )

    arr = ds.pixel_array.astype(
        np.float32
    )

    if arr.ndim != 2:
        raise RuntimeError(
            f"Expected 2-D image, got "
            f"{arr.shape}: {path}"
        )

    if (
        getattr(
            ds,
            "PhotometricInterpretation",
            "",
        ).upper()
        == "MONOCHROME1"
    ):
        arr = arr.max() - arr

    arr = np.nan_to_num(
        arr,
        nan=0.0,
        posinf=0.0,
        neginf=0.0,
    )

    lo = float(
        np.percentile(
            arr,
            1.0,
        )
    )

    hi = float(
        np.percentile(
            arr,
            99.0,
        )
    )

    if hi <= lo:

        lo = float(arr.min())
        hi = float(arr.max())

    if hi <= lo:

        arr = np.zeros_like(
            arr
        )

    else:

        arr = np.clip(
            arr,
            lo,
            hi,
        )

        arr = (
            arr - lo
        ) / (
            hi - lo
        )

    return arr


def image_tensor(
    image: np.ndarray,
) -> torch.Tensor:

    x = torch.from_numpy(
        image
    ).float()

    x = x.unsqueeze(0).unsqueeze(0)

    x = torch.nn.functional.interpolate(
        x,
        size=(
            IMAGE_SIZE,
            IMAGE_SIZE,
        ),
        mode="bilinear",
        align_corners=False,
    )

    x = x.squeeze(0)

    x = x.repeat(
        3,
        1,
        1,
    )

    return x


# ============================================================
# DATASET
# ============================================================

class CBISDataset(Dataset):

    def __init__(
        self,
        rows,
    ):
        self.rows = rows

    def __len__(
        self,
    ):
        return len(self.rows)

    def __getitem__(
        self,
        index,
    ):

        row = self.rows[index]

        image = load_dicom(
            row[
                "physical_cropped_dicom"
            ]
        )

        x = image_tensor(
            image
        )

        y = torch.tensor(
            float(
                row["binary_label"]
            ),
            dtype=torch.float32,
        )

        return (
            x,
            y,
            row["patient_id"],
        )


# ============================================================
# SHARED RESNET ENCODER
# ============================================================

class SharedEncoder(
    nn.Module
):

    def __init__(
        self,
    ):

        super().__init__()

        backbone = resnet50(
            weights=(
                ResNet50_Weights
                .IMAGENET1K_V2
            )
        )

        feature_dim = (
            backbone.fc.in_features
        )

        backbone.fc = nn.Identity()

        self.backbone = backbone

        self.projection = nn.Linear(
            feature_dim,
            LATENT_DIM,
        )

    def forward(
        self,
        x,
    ):

        h = self.backbone(
            x
        )

        z = self.projection(
            h
        )

        # Bound the latent representation
        # before angle encoding.
        z = torch.tanh(z)

        return z


# ============================================================
# MATCHED CLASSICAL HEAD
# ============================================================

class MatchedMLP(
    nn.Module
):

    def __init__(
        self,
    ):

        super().__init__()

        self.net = nn.Sequential(
            nn.Linear(
                LATENT_DIM,
                16,
            ),
            nn.ReLU(),
            nn.Linear(
                16,
                1,
            ),
        )

    def forward(
        self,
        z,
    ):

        return self.net(
            z
        ).squeeze(
            1
        )


# ============================================================
# SIX-QUBIT VQC
# ============================================================

dev = qml.device(
    "default.qubit",
    wires=N_QUBITS,
)


@qml.qnode(
    dev,
    interface="torch",
    diff_method="backprop",
)
def quantum_circuit(
    angles,
    weights,
):

    for q in range(
        N_QUBITS
    ):
        qml.RY(
            angles[q],
            wires=q,
        )

    for d in range(
        VQC_DEPTH
    ):

        for q in range(
            N_QUBITS
        ):
            qml.RY(
                weights[d, q, 0],
                wires=q,
            )
            qml.RZ(
                weights[d, q, 1],
                wires=q,
            )

        for q in range(
            N_QUBITS - 1
        ):
            qml.CNOT(
                wires=[
                    q,
                    q + 1,
                ]
            )

        qml.CNOT(
            wires=[
                N_QUBITS - 1,
                0,
            ]
        )

    return qml.expval(
        qml.PauliZ(0)
    )


class VQCHead(
    nn.Module
):

    def __init__(
        self,
    ):

        super().__init__()

        self.angle_projection = nn.Linear(
            LATENT_DIM,
            N_QUBITS,
        )

        self.quantum_weights = nn.Parameter(
            0.01
            * torch.randn(
                VQC_DEPTH,
                N_QUBITS,
                2,
            )
        )

        self.readout = nn.Linear(
            1,
            1,
        )

    def forward(
        self,
        z,
    ):

        angles = (
            np.pi
            * torch.tanh(
                self.angle_projection(
                    z
                )
            )
        )

        outputs = []

        for i in range(
            z.shape[0]
        ):

            angle_cpu = angles[i].to(
                device="cpu"
            )

            q = quantum_circuit(
                angle_cpu,
                self.quantum_weights.to(
                    device="cpu"
                ),
            )

            outputs.append(
                q.to(
                    z.device
                )
            )

        q_values = torch.stack(
            outputs
        ).reshape(
            -1,
            1,
        )

        logits = self.readout(
            q_values
        ).squeeze(
            1
        )

        return logits


# ============================================================
# DATA PREPARATION
# ============================================================

def split_rows(
    rows,
):

    out = {}

    for split in (
        "train",
        "calibration",
        "internal_test",
    ):

        out[split] = [
            r
            for r in rows
            if r[
                "experimental_split"
            ]
            == split
        ]

    return out


# ============================================================
# ENCODER FEATURE EXTRACTION
# ============================================================

@torch.no_grad()
def extract_latents(
    encoder,
    loader,
):

    encoder.eval()

    all_z = []
    all_y = []
    all_pid = []

    for x, y, pids in loader:

        x = x.to(
            DEVICE,
            non_blocking=True,
        )

        z = encoder(
            x
        )

        all_z.append(
            z.cpu()
        )

        all_y.extend(
            y.numpy().tolist()
        )

        all_pid.extend(
            list(pids)
        )

    return (
        torch.cat(
            all_z,
            dim=0,
        ),
        torch.tensor(
            all_y,
            dtype=torch.float32,
        ),
        all_pid,
    )


class LatentDataset(
    Dataset
):

    def __init__(
        self,
        z,
        y,
        pids,
    ):

        self.z = z
        self.y = y
        self.pids = pids

    def __len__(
        self,
    ):
        return self.z.shape[0]

    def __getitem__(
        self,
        index,
    ):

        return (
            self.z[index],
            self.y[index],
            self.pids[index],
        )


# ============================================================
# METRICS
# ============================================================

def metrics(
    y,
    p,
):

    pred = (
        p >= 0.5
    ).astype(int)

    return {
        "accuracy": float(
            accuracy_score(
                y,
                pred,
            )
        ),
        "balanced_accuracy": float(
            balanced_accuracy_score(
                y,
                pred,
            )
        ),
        "precision": float(
            precision_score(
                y,
                pred,
                zero_division=0,
            )
        ),
        "recall": float(
            recall_score(
                y,
                pred,
                zero_division=0,
            )
        ),
        "f1": float(
            f1_score(
                y,
                pred,
                zero_division=0,
            )
        ),
        "roc_auc": float(
            roc_auc_score(
                y,
                p,
            )
        ),
    }


@torch.no_grad()
def predict_head(
    head,
    loader,
):

    head.eval()

    y_all = []
    p_all = []
    ids_all = []

    for z, y, pids in loader:

        z = z.to(
            DEVICE
        )

        logits = head(
            z
        )

        p = torch.sigmoid(
            logits
        )

        y_all.extend(
            y.numpy().tolist()
        )

        p_all.extend(
            p.detach().cpu().numpy().tolist()
        )

        ids_all.extend(
            list(pids)
        )

    return (
        np.asarray(
            y_all,
            dtype=np.float32,
        ),
        np.asarray(
            p_all,
            dtype=np.float32,
        ),
        ids_all,
    )


# ============================================================
# TRAIN HEAD
# ============================================================

def train_head(
    name,
    head,
    train_loader,
    cal_loader,
    epochs,
    lr,
):

    head = head.to(
        DEVICE
    )

    criterion = nn.BCEWithLogitsLoss()

    optimizer = torch.optim.AdamW(
        head.parameters(),
        lr=lr,
        weight_decay=WEIGHT_DECAY,
    )

    best_auc = -1.0
    best_epoch = -1

    best_path = (
        OUTPUT_ROOT
        / f"{name}_best.pt"
    )

    history = []

    for epoch in range(
        1,
        epochs + 1,
    ):

        head.train()

        total_loss = 0.0
        total_n = 0

        for z, y, _ in train_loader:

            z = z.to(
                DEVICE
            )

            y = y.to(
                DEVICE
            )

            optimizer.zero_grad(
                set_to_none=True
            )

            logits = head(
                z
            )

            loss = criterion(
                logits,
                y,
            )

            loss.backward()

            optimizer.step()

            n = y.shape[0]

            total_loss += (
                loss.item()
                * n
            )

            total_n += n

        y_cal, p_cal, _ = predict_head(
            head,
            cal_loader,
        )

        auc = roc_auc_score(
            y_cal,
            p_cal,
        )

        avg_loss = (
            total_loss
            / max(
                total_n,
                1,
            )
        )

        history.append({
            "epoch": epoch,
            "train_loss": float(
                avg_loss
            ),
            "calibration_roc_auc": float(
                auc
            ),
        })

        print(
            f"{name} epoch "
            f"{epoch:02d}/{epochs} "
            f"| loss={avg_loss:.6f} "
            f"| cal ROC-AUC={auc:.6f}",
            flush=True,
        )

        if auc > best_auc:

            best_auc = auc
            best_epoch = epoch

            torch.save(
                head.state_dict(),
                best_path,
            )

    head.load_state_dict(
        torch.load(
            best_path,
            map_location=DEVICE,
        )
    )

    return (
        head,
        best_auc,
        best_epoch,
        history,
        best_path,
    )


# ============================================================
# MAIN
# ============================================================

def main():

    seed_everything(
        SEED
    )

    print("=" * 80)
    print("CBIS-DDSM CORE SHARED-LATENT VQC PILOT")
    print("=" * 80)

    print(
        "Manifest:",
        MANIFEST,
    )

    print(
        "Device:",
        DEVICE,
    )

    if torch.cuda.is_available():

        print(
            "GPU:",
            torch.cuda.get_device_name(
                0
            ),
        )

    print(
        "PennyLane:",
        qml.__version__,
    )

    rows = list(
        csv.DictReader(
            MANIFEST.open(
                encoding="utf-8-sig",
                newline="",
            )
        )
    )

    splits = split_rows(
        rows
    )

    print()
    print(
        "Records:",
        {
            k: len(v)
            for k, v in splits.items()
        },
    )

    train_ds = CBISDataset(
        splits["train"]
    )

    cal_ds = CBISDataset(
        splits["calibration"]
    )

    test_ds = CBISDataset(
        splits["internal_test"]
    )

    train_loader = DataLoader(
        train_ds,
        batch_size=BATCH_SIZE,
        shuffle=False,
        num_workers=NUM_WORKERS,
        pin_memory=torch.cuda.is_available(),
    )

    cal_loader = DataLoader(
        cal_ds,
        batch_size=BATCH_SIZE,
        shuffle=False,
        num_workers=NUM_WORKERS,
        pin_memory=torch.cuda.is_available(),
    )

    test_loader = DataLoader(
        test_ds,
        batch_size=BATCH_SIZE,
        shuffle=False,
        num_workers=NUM_WORKERS,
        pin_memory=torch.cuda.is_available(),
    )

    # --------------------------------------------------------
    # Shared encoder
    # --------------------------------------------------------

    encoder = SharedEncoder().to(
        DEVICE
    )

    # Freeze backbone for this pilot.
    for p in encoder.backbone.parameters():
        p.requires_grad = False

    # Projection remains trainable.
    for p in encoder.projection.parameters():
        p.requires_grad = True

    projection_optimizer = torch.optim.AdamW(
        encoder.projection.parameters(),
        lr=1e-3,
        weight_decay=WEIGHT_DECAY,
    )

    criterion = nn.BCEWithLogitsLoss()

    # Temporary probe for representation learning.
    probe = nn.Linear(
        LATENT_DIM,
        1,
    ).to(
        DEVICE
    )

    probe_optimizer = torch.optim.AdamW(
        list(
            encoder.projection.parameters()
        )
        + list(
            probe.parameters()
        ),
        lr=1e-3,
        weight_decay=WEIGHT_DECAY,
    )

    print()
    print(
        "Learning shared 32-D projection..."
    )

    encoder.train()
    probe.train()

    best_probe_auc = -1.0
    best_probe_epoch = -1

    projection_ckpt = (
        OUTPUT_ROOT
        / "shared_encoder_projection_best.pt"
    )

    for epoch in range(
        1,
        EPOCHS_MLP + 1,
    ):

        encoder.train()
        probe.train()

        total_loss = 0.0
        total_n = 0

        for x, y, _ in train_loader:

            x = x.to(
                DEVICE,
                non_blocking=True,
            )

            y = y.to(
                DEVICE,
                non_blocking=True,
            )

            probe_optimizer.zero_grad(
                set_to_none=True
            )

            z = encoder(
                x
            )

            logits = probe(
                z
            ).squeeze(
                1
            )

            loss = criterion(
                logits,
                y,
            )

            loss.backward()

            probe_optimizer.step()

            n = y.shape[0]

            total_loss += (
                loss.item()
                * n
            )

            total_n += n

        encoder.eval()
        probe.eval()

        y_cal = []
        p_cal = []

        for x, y, _ in cal_loader:

            x = x.to(
                DEVICE,
                non_blocking=True,
            )

            z = encoder(
                x
            )

            logits = probe(
                z
            ).squeeze(
                1
            )

            p = torch.sigmoid(
                logits
            )

            y_cal.extend(
                y.numpy().tolist()
            )

            p_cal.extend(
                p.detach().cpu().numpy().tolist()
            )

        cal_auc = roc_auc_score(
            y_cal,
            p_cal,
        )

        avg_loss = (
            total_loss
            / max(
                total_n,
                1,
            )
        )

        print(
            f"shared encoder epoch "
            f"{epoch:02d}/{EPOCHS_MLP} "
            f"| loss={avg_loss:.6f} "
            f"| cal ROC-AUC={cal_auc:.6f}",
            flush=True,
        )

        if cal_auc > best_probe_auc:

            best_probe_auc = cal_auc
            best_probe_epoch = epoch

            torch.save(
                {
                    "encoder_projection":
                        encoder.projection.state_dict(),
                    "probe":
                        probe.state_dict(),
                },
                projection_ckpt,
            )

    state = torch.load(
        projection_ckpt,
        map_location=DEVICE,
    )

    encoder.projection.load_state_dict(
        state[
            "encoder_projection"
        ]
    )

    # --------------------------------------------------------
    # Extract shared latents.
    # --------------------------------------------------------

    print()
    print(
        "Extracting shared 32-D latents..."
    )

    train_z, train_y, train_pid = extract_latents(
        encoder,
        train_loader,
    )

    cal_z, cal_y, cal_pid = extract_latents(
        encoder,
        cal_loader,
    )

    test_z, test_y, test_pid = extract_latents(
        encoder,
        test_loader,
    )

    latent_file = (
        OUTPUT_ROOT
        / "SHARED_LATENTS.pt"
    )

    torch.save(
        {
            "train_z": train_z,
            "train_y": train_y,
            "train_patient_id": train_pid,
            "calibration_z": cal_z,
            "calibration_y": cal_y,
            "calibration_patient_id": cal_pid,
            "internal_test_z": test_z,
            "internal_test_y": test_y,
            "internal_test_patient_id": test_pid,
            "latent_dim": LATENT_DIM,
            "seed": SEED,
        },
        latent_file,
    )

    # --------------------------------------------------------
    # Latent loaders
    # --------------------------------------------------------

    latent_train = DataLoader(
        LatentDataset(
            train_z,
            train_y,
            train_pid,
        ),
        batch_size=64,
        shuffle=True,
    )

    latent_cal = DataLoader(
        LatentDataset(
            cal_z,
            cal_y,
            cal_pid,
        ),
        batch_size=64,
        shuffle=False,
    )

    latent_test = DataLoader(
        LatentDataset(
            test_z,
            test_y,
            test_pid,
        ),
        batch_size=64,
        shuffle=False,
    )

    # --------------------------------------------------------
    # Matched classical head
    # --------------------------------------------------------

    print()
    print("=" * 80)
    print("MATCHED CLASSICAL MLP")
    print("=" * 80)

    mlp = MatchedMLP()

    (
        mlp,
        mlp_auc,
        mlp_epoch,
        mlp_history,
        mlp_checkpoint,
    ) = train_head(
        "matched_mlp",
        mlp,
        latent_train,
        latent_cal,
        EPOCHS_MLP,
        LR_MLP,
    )

    y_mlp, p_mlp, id_mlp = predict_head(
        mlp,
        latent_test,
    )

    mlp_metrics = metrics(
        y_mlp,
        p_mlp,
    )

    # --------------------------------------------------------
    # Quantum head
    # --------------------------------------------------------

    print()
    print("=" * 80)
    print("6-QUBIT VQC")
    print("=" * 80)

    print(
        "Qubits:",
        N_QUBITS,
    )

    print(
        "Depth:",
        VQC_DEPTH,
    )

    vqc = VQCHead()

    (
        vqc,
        vqc_auc,
        vqc_epoch,
        vqc_history,
        vqc_checkpoint,
    ) = train_head(
        "vqc",
        vqc,
        latent_train,
        latent_cal,
        EPOCHS_VQC,
        LR_VQC,
    )

    y_vqc, p_vqc, id_vqc = predict_head(
        vqc,
        latent_test,
    )

    vqc_metrics = metrics(
        y_vqc,
        p_vqc,
    )

    # --------------------------------------------------------
    # Parameter counts
    # --------------------------------------------------------

    encoder_trainable = sum(
        p.numel()
        for p in encoder.parameters()
        if p.requires_grad
    )

    mlp_parameters = sum(
        p.numel()
        for p in mlp.parameters()
        if p.requires_grad
    )

    vqc_parameters = sum(
        p.numel()
        for p in vqc.parameters()
        if p.requires_grad
    )

    print()
    print("=" * 80)
    print("CORE PILOT SUMMARY")
    print("=" * 80)

    print(
        "Shared latent dimension:",
        LATENT_DIM,
    )

    print(
        "VQC qubits:",
        N_QUBITS,
    )

    print(
        "VQC depth:",
        VQC_DEPTH,
    )

    print(
        "Encoder trainable parameters:",
        encoder_trainable,
    )

    print(
        "Matched MLP parameters:",
        mlp_parameters,
    )

    print(
        "VQC head parameters:",
        vqc_parameters,
    )

    print()
    print(
        "MLP calibration ROC-AUC:",
        mlp_auc,
    )

    print(
        "MLP test ROC-AUC:",
        mlp_metrics["roc_auc"],
    )

    print(
        "VQC calibration ROC-AUC:",
        vqc_auc,
    )

    print(
        "VQC test ROC-AUC:",
        vqc_metrics["roc_auc"],
    )

    # --------------------------------------------------------
    # Save prediction table
    # --------------------------------------------------------

    prediction_file = (
        OUTPUT_ROOT
        / "CORE_PILOT_PREDICTIONS.csv"
    )

    with prediction_file.open(
        "w",
        newline="",
        encoding="utf-8-sig",
    ) as f:

        w = csv.writer(f)

        w.writerow([
            "patient_id",
            "label",
            "mlp_probability",
            "vqc_probability",
        ])

        for i in range(
            len(test_pid)
        ):

            w.writerow([
                test_pid[i],
                int(test_y[i]),
                float(p_mlp[i]),
                float(p_vqc[i]),
            ])

    # --------------------------------------------------------
    # Final JSON
    # --------------------------------------------------------

    results = {
        "experiment":
            "CBIS-DDSM shared latent matched MLP vs VQC pilot",

        "seed":
            SEED,

        "image_size":
            IMAGE_SIZE,

        "latent_dim":
            LATENT_DIM,

        "qubits":
            N_QUBITS,

        "vqc_depth":
            VQC_DEPTH,

        "train_records":
            len(train_z),

        "calibration_records":
            len(cal_z),

        "internal_test_records":
            len(test_z),

        "best_shared_projection_calibration_auc":
            float(best_probe_auc),

        "best_shared_projection_epoch":
            int(best_probe_epoch),

        "matched_mlp": {
            "parameters":
                mlp_parameters,
            "best_calibration_auc":
                float(mlp_auc),
            "best_epoch":
                int(mlp_epoch),
            "internal_test_metrics":
                mlp_metrics,
            "checkpoint":
                str(mlp_checkpoint),
            "history":
                mlp_history,
        },

        "vqc": {
            "parameters":
                vqc_parameters,
            "best_calibration_auc":
                float(vqc_auc),
            "best_epoch":
                int(vqc_epoch),
            "internal_test_metrics":
                vqc_metrics,
            "checkpoint":
                str(vqc_checkpoint),
            "history":
                vqc_history,
        },

        "latent_file":
            str(latent_file),

        "prediction_file":
            str(prediction_file),

        "status":
            "PILOT_COMPLETE",
    }

    results_file = (
        OUTPUT_ROOT
        / "CORE_PILOT_RESULTS.json"
    )

    results_file.write_text(
        json.dumps(
            results,
            indent=2,
        ),
        encoding="utf-8",
    )

    print()
    print(
        "Latents:",
        latent_file,
    )

    print(
        "Predictions:",
        prediction_file,
    )

    print(
        "Results:",
        results_file,
    )

    print()
    print(
        "STATUS: CORE PILOT COMPLETE"
    )


if __name__ == "__main__":
    main()